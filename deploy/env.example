# Copy to secrets/<server>.<environment>.env and set for this host.
# Every value here names a machine rather than the project, so secrets/ is gitignored whole.
# CI sets the deploy values from environment secrets and reads no file.
#
# One file per environment, named for the server it describes and the environment on it,
# with both words spelled out, and selected by ENV_FILE:
#   secrets/local.production.env   the default, read when ENV_FILE is unset
#   secrets/local.staging.env      ENV_FILE=secrets/local.staging.env deploy/make-release.sh
#   secrets/vps.production.env     ENV_FILE=secrets/vps.production.env deploy/make-release.sh
#   secrets/vps.staging.env        ENV_FILE=secrets/vps.staging.env deploy/make-release.sh
#
# The file is sourced with `set -a`, which overwrites a variable the caller exported first.
# Selecting the file is therefore how an environment is chosen.
# The first argument to make-release.sh is how its root is overridden.
# A named file that does not exist is a hard failure rather than a fall-through.
#
# Naming convention: the prefix names whatever owns the value, not whatever reads it.
# HUGO_ is fixed by Hugo, which maps HUGO_<KEY> onto its own config natively.
# DEPLOY_ is the release tooling, which writes the deploy root.
# CADDY_ is the container, which owns state the release never touches.
# PANGOLIN_ is the proxy, which owns the credential that opens its auth gate.

# Written by every release, and mounted read-only by the container at /srv/blog.
# The first argument to make-release.sh wins over this value.
DEPLOY_ROOT=/path/to/deploy/root

# Must be set for anything that is not production.
# The base URL is baked into the canonical tag, the feed links, and every absolute permalink.
# A mirror built without it serves pages pointing back at production, and every gate still passes.
HUGO_BASEURL=https://blog.example.com/

# The container's persistent state root, deliberately outside DEPLOY_ROOT.
# Two directories hang off it, and a release writes neither:
#   <CADDY_APPDATA>/config  mounted at /config, holding the bootstrap Caddyfile
#   <CADDY_APPDATA>/data    mounted at /data, holding Caddy state and the reload autosave
# No script reads this, so it is recorded to keep a rebuild from depending on memory.
CADDY_APPDATA=/path/to/container/appdata

# The container serving this environment.
# A release needs no restart, because Caddy reloads its config in process.
# Restarting is the remedy when the watcher dies, which it does silently after one failed load.
#
# Environments are named production and staging, spelled out, with no prod or stage anywhere.
# The name is compared, by EXPECT_SITE_ENV below and by the deploy.
# A spelling that differs by environment fails a deploy for a reason that reads like an outage.
CADDY_CONTAINER=blog-production

# A resource access token, read by check-live-urls.sh, for an environment behind the auth gate.
# Staging keeps its gate on, because it serves a byte-identical copy of the public site.
# Set both or neither, and leave both unset for a site that is public.
PANGOLIN_ACCESS_TOKEN_ID=
PANGOLIN_ACCESS_TOKEN=

# The environment that must answer, compared against the X-Blog-Env header the bundle stamps.
# A proxy rule aimed at the wrong container returns a healthy 200 under the right hostname.
# Checking the URL contract against that proves nothing, so the check refuses to start.
EXPECT_SITE_ENV=production

# Read by the deploy workflow, which resolves them from the GitHub Environment rather than a file.
# They are named here so the local file and the environment describe the same shape.
# A local run deploys to a path and needs none of them.
#DEPLOY_SSH_HOST=
#DEPLOY_SSH_USER=
#DEPLOY_SSH_KNOWN_HOSTS=

# The provenance capture, holding the WordPress exports, the crawl of the old platform, and the inventories derived from it.
# checks/build-redirects.py takes this directory as its one argument and rebuilds deploy/maps/ from it.
# Environment-independent, unlike every value above, so keep it in the default file, secrets/local.production.env, and drop it from any per-environment copy of this template.
# Nothing sources this value, so it is recorded to keep a rebuild from depending on memory.
CAPTURE_ROOT=/path/to/blog-capture

# The off-host copy of the VPS access log, which OPERATIONS.md "Log Review" reads and vps-backup-pull writes.
# The encrypted host archives sit in a sibling directory and belong to the host rather than to this repo, so they are not named here.
# Environment-independent, like CAPTURE_ROOT above, so keep it in secrets/local.production.env and drop it from any per-environment copy.
# Nothing sources this value either. It is recorded because the alternative is a path that lives only in a gitignored session note and in the pull script's own defaults, which is how a review procedure ends up unable to say where the data it reviews is kept.
LOG_ARCHIVE_ROOT=/path/to/vps-logs

# The off-host copy of the encrypted host archives and the plaintext hostconfig tree beside them.
# The plaintext copy is what makes the VPS's own configuration readable without the encryption key, which is not held here and must not be.
BACKUP_ARCHIVE_ROOT=/path/to/vps-archives

# The VPS administrative connection, which is NOT the deploy connection above.
# DEPLOY_SSH_USER reaches a confined account behind an rrsync forced command that can write one release tree and read nothing.
# This one is the ordinary admin login, used for reading logs, reading the archive directory, and moving the channel files.
# They are separate values because they are separate credentials with different blast radii, and reaching for the wrong one either fails confusingly or grants far more than the task needed.
# Environment-independent, like CAPTURE_ROOT above: there is one such host, not one per environment.
VPS_SSH_HOST=root@vps.example.com

# Where the VPS keeps the access log, whose rotated files LOG_ARCHIVE_ROOT is the off-host copy of.
# Today's live file is deliberately never pulled, because it is still being appended to and a copy is a torn prefix.
# So an analysis covering today reads VPS_TRAEFIK_LOG over SSH and everything older from LOG_ARCHIVE_ROOT.
VPS_TRAEFIK_LOG=/var/log/traefik/access.log
VPS_TRAEFIK_LOG_ARCHIVE=/var/log/traefik/archive

# The two agent channel files, described under "The Channel Between the Two Sides".
VPS_COMMS_DIR=/srv/agent-comms
