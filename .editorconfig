# https://editorconfig.org

# Root config
root = true

# The default is LF rather than the fleet CRLF default.
# The `[*]` default follows the consuming application's native platform.
# Everything here is consumed by Linux.
# - Hugo builds the site in CI.
# - Caddy and OpenSSH read their config on an Ubuntu VPS.
# - The deploy scripts run there too.
# Taking the CRLF default would mean an LF override for nearly every file.
# That is the over-normalization the rule exists to prevent.
# Because LF is the default, the per-file pins the fleet baseline carries are unnecessary.
# Git's own enforcement for execution-sensitive files lives in `.gitattributes`.
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts indent with tabs, which is the shell convention and what `<<-` heredocs require.
# The formatter reads this file, so declaring it here is what keeps `shfmt -d` agreeing with the scripts.
[*.sh]
indent_style = tab

# Two trailing spaces are a hard line break in Markdown.
# Trimming them silently rewrites the content.
[*.md]
trim_trailing_whitespace = false

# Xml files
[*.xml]
indent_size = 2

# Yaml files. `hugo.yaml` and the workflows are the bulk of this repo's configuration.
[*.{yml,yaml}]
indent_size = 2

# JSON, including the parity-gate fixtures and `version.json`
[*.json]
indent_size = 2

# Byte-preserve the data directories.
# These are 566 MB of images, a video, and archives carried from the WordPress export.
# Every file is hash-verified against that export.
# A tool that "fixes" a charset, adds a final newline, or trims whitespace breaks the hash.
# Every text-shaped rule is therefore switched off rather than merely relaxed.
# `.gitattributes` marks the same two trees binary so git will not diff or merge them either.
[static/{media,external}/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

# The favicon set at the static root is binary for the same reason.
# It matches no directory rule above.
[*.{ico,png,jpg,gif,webp,mov,zip}]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

# Caddy map files are tab-separated redirect tables generated by `capture/build-redirects.py`.
# Trailing whitespace is significant to the parse, and the generator owns the formatting.
[deploy/maps/*.map]
trim_trailing_whitespace = false
insert_final_newline = true
